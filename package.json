{
  "name": "anniti-smart-aurora-gallery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start:runtime": "node server/index.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:external": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:qa": "npm run lint && npm run typecheck && npm run test:unit && npm run test:e2e",
    "visual:capture": "node scripts/visual/capture.mjs",
    "visual:compare": "python scripts/visual/compare.py",
    "lint": "eslint src tests e2e vite.config.ts vitest.config.ts playwright.config.ts --max-warnings 0"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "typescript": "6.0.3",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
